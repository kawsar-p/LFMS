@model List<LFMS.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    var unread = Model.Count(x => !x.IsRead);
}

<div class="section-heading">
    <div>
        <p class="eyebrow">UPDATES</p>
        <h1>Notifications</h1>
        <p class="muted">@unread unread notification@(unread == 1 ? "" : "s").</p>
    </div>
    @if (unread > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-dark">Mark all as read</button>
        </form>
    }
</div>

<div class="notifications-list">
    @if (Model.Count == 0)
    {
        <div class="empty-state">No notifications yet.</div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="notification-item @(item.IsRead ? "is-read" : "is-unread")">
                <div>
                    <strong>@item.Message</strong>
                    <div class="muted small">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</div>
                </div>
                @if (!item.IsRead || !string.IsNullOrWhiteSpace(item.Link))
                {
                    <form asp-action="MarkRead" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="notification-action" type="submit">@(string.IsNullOrWhiteSpace(item.Link) ? "Read" : "Open")</button>
                    </form>
                }
            </div>
        }
    }
</div>
