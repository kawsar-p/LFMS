@model LFMS.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page">
    <div class="section-heading">
        <div>
            <p class="eyebrow">ACCOUNT</p>
            <h1>My Profile</h1>
            <p class="muted">Update your personal information and account password.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="notice-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="notice-error">@TempData["Error"]</div>
    }

    <div class="profile-settings-grid">
        <section class="profile-form-card">
            <form asp-action="Index" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="profile-image-editor">
                    <div class="profile-image-large">
                        <img src="@(string.IsNullOrWhiteSpace(ViewBag.ProfileImagePath as string) ? Url.Content("~/images/default-avatar.svg") : (ViewBag.ProfileImagePath as string))" alt="Profile" />
                    </div>
                    <div>
                        <label for="ProfileImage">Profile photo</label>
                        <input id="ProfileImage" name="ProfileImage" type="file" accept=".jpg,.jpeg,.png,.webp" />
                        <p class="muted small">JPG, PNG or WEBP, up to 5 MB.</p>
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" autocomplete="name" />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="PhoneNumber"></label>
                    <input asp-for="PhoneNumber" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>

                <hr />

                <h3>Change password</h3>
                <p class="muted small">Leave these fields empty if you do not want to change your password.</p>

                <div class="form-field">
                    <label asp-for="NewPassword"></label>
                    <div class="password-input-wrap">
<input asp-for="NewPassword" autocomplete="new-password" data-password-input />
<button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
    <svg data-eye viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
    <svg data-eye-off viewBox="0 0 24 24" aria-hidden="true" style="display:none"><path d="m3 3 18 18"/><path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a17 17 0 0 1-3.1 3.7M6.1 6.8C3.7 8.6 2.5 12 2.5 12S6 18 12 18c1.2 0 2.3-.2 3.3-.6"/><path d="M9.9 9.9a2.5 2.5 0 0 0 3.5 3.5"/></svg>
</button>
</div>
                    <div class="password-requirements" data-password-requirements>
                        <div class="password-requirement" data-rule="length"><span>○</span> At least 6 characters</div>
                        <div class="password-requirement" data-rule="digit"><span>○</span> At least 1 number (0-9)</div>
                    </div>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ConfirmNewPassword"></label>
                    <div class="password-input-wrap">
<input asp-for="ConfirmNewPassword" autocomplete="new-password" />
<button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
    <svg data-eye viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
    <svg data-eye-off viewBox="0 0 24 24" aria-hidden="true" style="display:none"><path d="m3 3 18 18"/><path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a17 17 0 0 1-3.1 3.7M6.1 6.8C3.7 8.6 2.5 12 2.5 12S6 18 12 18c1.2 0 2.3-.2 3.3-.6"/><path d="M9.9 9.9a2.5 2.5 0 0 0 3.5 3.5"/></svg>
</button>
</div>
                    <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
                </div>

                <button class="btn btn-accent" type="submit">Save changes</button>
            </form>
        </section>

        <aside class="profile-side-card">
            <p class="eyebrow">ACCOUNT ACTIONS</p>
            <a class="profile-side-link" asp-controller="Posts" asp-action="MyPosts">View my posts</a>
            <a class="profile-side-link" asp-controller="Notifications" asp-action="Index">View notifications</a>

            @if (!User.IsInRole("Admin"))
            {
                <div class="danger-zone">
                    <h3>Delete account</h3>
                    <p class="muted small">This permanently removes your account, posts, comments and likes.</p>
                    <form asp-action="DeleteAccount" method="post" onsubmit="return confirm('Delete your account permanently? This cannot be undone.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="danger-button">Delete my account</button>
                    </form>
                </div>
            }
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function(){
        const input = document.querySelector('[data-password-input]');
        if (!input) return;
        const rules = {
            length: value => value.length === 0 || value.length >= 6,
            digit: value => value.length === 0 || /[0-9]/.test(value)
        };
        function update() {
            document.querySelectorAll('[data-password-requirements] [data-rule]').forEach(el => {
                const ok = !!rules[el.dataset.rule]?.(input.value);
                el.classList.toggle('valid', ok);
                const icon = el.querySelector('span');
                if (icon) icon.textContent = ok ? '✓' : '○';
            });
        }
        input.addEventListener('input', update);
        update();
    })();
    </script>
}
