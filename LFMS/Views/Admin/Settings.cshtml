@model AdminSettingsViewModel
@{
    ViewData["Title"] = "Admin Settings";
}

<div class="section-heading admin-heading">
    <div>
        <p class="eyebrow">ADMIN SETTINGS</p>
        <h1>Account settings</h1>
        <p class="muted admin-subtitle">Change the administrator email or set a new password.</p>
    </div>
    <a asp-action="Dashboard" class="create-back">Back to dashboard</a>
</div>

<div class="admin-settings-layout">
    <div class="settings-intro">
        <div class="settings-number">01</div>
        <h2>Administrator account</h2>
        <p>Only users with the Admin role can access this page.</p>
        <div class="settings-note">Leave the new password fields empty if you only want to change the email.</div>
    </div>

    <form asp-action="Settings" method="post" class="settings-card">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="form-error"></div>

        @if (TempData["Success"] is string success)
        {
            <div class="success-message">@success</div>
        }

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>

        <div class="settings-divider"></div>

        <div class="settings-group-title">Change password</div>

        <div class="field">
            <label asp-for="NewPassword"></label>
            <div class="password-input-wrap">
<input asp-for="NewPassword" autocomplete="new-password" placeholder="Leave empty to keep current password" data-password-input />
<button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
    <svg data-eye viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
    <svg data-eye-off viewBox="0 0 24 24" aria-hidden="true" style="display:none"><path d="m3 3 18 18"/><path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a17 17 0 0 1-3.1 3.7M6.1 6.8C3.7 8.6 2.5 12 2.5 12S6 18 12 18c1.2 0 2.3-.2 3.3-.6"/><path d="M9.9 9.9a2.5 2.5 0 0 0 3.5 3.5"/></svg>
</button>
</div>
            <div class="password-requirements" data-password-requirements>
                <div class="password-requirement" data-rule="length"><span>○</span> At least 6 characters</div>
                <div class="password-requirement" data-rule="digit"><span>○</span> At least 1 number (0-9)</div>
            </div>
            <span asp-validation-for="NewPassword" class="form-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmNewPassword"></label>
            <div class="password-input-wrap">
<input asp-for="ConfirmNewPassword" autocomplete="new-password" />
<button type="button" class="password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
    <svg data-eye viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
    <svg data-eye-off viewBox="0 0 24 24" aria-hidden="true" style="display:none"><path d="m3 3 18 18"/><path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a17 17 0 0 1-3.1 3.7M6.1 6.8C3.7 8.6 2.5 12 2.5 12S6 18 12 18c1.2 0 2.3-.2 3.3-.6"/><path d="M9.9 9.9a2.5 2.5 0 0 0 3.5 3.5"/></svg>
</button>
</div>
            <span asp-validation-for="ConfirmNewPassword" class="form-error"></span>
        </div>

        <button type="submit" class="publish-button settings-save">Save changes</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function(){
      const input=document.querySelector('[data-password-input]');
      if(!input)return;
      const rules={length:v=>v.length===0||v.length>=6,digit:v=>v.length===0||/[0-9]/.test(v)};
      function update(){
        document.querySelectorAll('[data-password-requirements] [data-rule]').forEach(el=>{
          const ok=!!rules[el.dataset.rule]?.(input.value);
          el.classList.toggle('valid',ok);
          const icon=el.querySelector('span'); if(icon) icon.textContent=ok?'✓':'○';
        });
      }
      input.addEventListener('input',update); update();
    })();
    </script>
}
