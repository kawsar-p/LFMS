                'Claim this item':'এই পণ্যটি দাবি করুন','Confirm collection / return':'পণ্য সংগ্রহ / ফেরত নিশ্চিত করুন','Collection requests':'কালেকশন রিকোয়েস্ট','Admin Dashboard':'অ্যাডমিন ড্যাশবোর্ড','Every submitted recovery or return confirmation is stored here.':'প্রতিটি উদ্ধার বা ফেরতের নিশ্চিতকরণ এখানে সংরক্ষণ করা হয়।','No collection confirmations have been submitted yet.':'এখনও কোনো কালেকশন নিশ্চিতকরণ জমা হয়নি।',
                'LOST & FOUND COMMUNITY':'লস্ট অ্যান্ড ফাউন্ড কমিউনিটি','LOST &amp; FOUND MANAGEMENT SYSTEM':'লস্ট অ্যান্ড ফাউন্ড ম্যানেজমেন্ট সিস্টেম','LOST & FOUND MANAGEMENT SYSTEM':'লস্ট অ্যান্ড ফাউন্ড ম্যানেজমেন্ট সিস্টেম','Find what was lost.':'যা হারিয়েছে তা খুঁজুন।','Return what was found.':'যা পাওয়া গেছে তা ফিরিয়ে দিন।','A simple community space to report lost items, share found items, and help them reach their owners.':'হারানো আইটেমের তথ্য দেওয়া, পাওয়া আইটেম শেয়ার করা এবং মালিকের কাছে পৌঁছাতে সাহায্য করার সহজ কমিউনিটি প্ল্যাটফর্ম।','Simple reporting. Helpful people. Better chances of returning lost belongings.':'সহজ রিপোর্টিং। সহায়ক মানুষ। হারানো জিনিস ফেরত পাওয়ার আরও ভালো সুযোগ।','New here?':'নতুন ব্যবহারকারী?','Already registered?':'ইতোমধ্যে রেজিস্টার করেছেন?','Log in':'লগইন','Register':'রেজিস্টার','Remember me':'আমাকে মনে রাখুন','Password':'পাসওয়ার্ড','Confirm password':'পাসওয়ার্ড নিশ্চিত করুন','Full name':'পূর্ণ নাম','Mobile number':'মোবাইল নম্বর','Email':'ইমেইল','At least 6 characters':'কমপক্ষে ৬টি অক্ষর','At least 1 number (0-9)':'কমপক্ষে ১টি সংখ্যা (০-৯)','Enter your password':'আপনার পাসওয়ার্ড দিন','Repeat your password':'পাসওয়ার্ড আবার লিখুন','Create account':'অ্যাকাউন্ট তৈরি করুন','Already have an account?':'ইতোমধ্যে অ্যাকাউন্ট আছে?','Don\'t have an account?':'অ্যাকাউন্ট নেই?','Log in - LFMS':'লগইন - LFMS','Register - LFMS':'রেজিস্টার - LFMS',
                'Profile updated successfully.':'প্রোফাইল সফলভাবে আপডেট হয়েছে.','The administrator account cannot be deleted here.':'অ্যাডমিনিস্ট্রেটর অ্যাকাউন্টটি এখান থেকে মুছে ফেলা যাবে না.','Post updated successfully.':'পোস্ট সফলভাবে আপডেট হয়েছে.','This post has already been confirmed as collected.':'এই পোস্টটি ইতোমধ্যে সংগৃহীত হিসেবে নিশ্চিত করা হয়েছে.','A collection confirmation has already been submitted for this post.':'এই পোস্টের জন্য কালেকশন নিশ্চিতকরণ ইতোমধ্যে জমা হয়েছে.','Collection confirmation submitted. The item is now recorded as collected.':'কালেকশন নিশ্চিতকরণ জমা হয়েছে. আইটেমটি এখন সংগৃহীত হিসেবে রেকর্ড করা হয়েছে.','You cannot deactivate your own admin account.':'আপনি নিজের অ্যাডমিন অ্যাকাউন্ট নিষ্ক্রিয় করতে পারবেন না.','You cannot delete your own admin account.':'আপনি নিজের অ্যাডমিন অ্যাকাউন্ট মুছতে পারবেন না.','Admin account settings updated successfully.':'অ্যাডমিন অ্যাকাউন্টের সেটিংস সফলভাবে আপডেট হয়েছে.','is now Active.':'এখন সক্রিয়.','is now Inactive.':'এখন নিষ্ক্রিয়.','Admin':'অ্যাডমিন','Admin Settings':'অ্যাডমিন সেটিংস','Settings':'সেটিংস','Only users with the Admin role can access this page.':'শুধুমাত্র অ্যাডমিন রোলের ব্যবহারকারীরা এই পেজে প্রবেশ করতে পারবেন।','ID Card':'আইডি কার্ড','Phone':'ফোন','Wallet':'ওয়ালেট','No image available':'কোনো ছবি নেই','View full image':'পূর্ণ ছবি দেখুন'
            };
            Object.assign(translations, extraTranslations);
            Object.assign(looseTranslations, extraTranslations);

            function translateLooseText(language) {
                const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
                const nodes = [];
                while (walker.nextNode()) nodes.push(walker.currentNode);
                nodes.forEach(node => {
                    const parent = node.parentElement;
                    if (!parent || parent.closest('script,style') || parent.hasAttribute('data-i18n')) return;
                    const current = node.nodeValue;
                    const clean = current.trim();
                    if (!clean) return;
                    if (!node.__lfmsOriginal) node.__lfmsOriginal = clean;
                    const original = node.__lfmsOriginal;
                    const translated = looseTranslations[original];
                    if (language === 'bn' && translated) node.nodeValue = current.replace(clean, translated);
                    if (language === 'en') node.nodeValue = current.replace(clean, original);
                });
            }
            function translateText(language) {
                document.querySelectorAll('[data-i18n]').forEach(el => {
                    const key = el.getAttribute('data-i18n');
                    el.textContent = language === 'bn' ? (translations[key] || key) : key;
                });
                document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                    const key = el.getAttribute('data-i18n-placeholder');
                    el.placeholder = language === 'bn' ? (translations[key] || key) : key;
                });
                document.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(el => {
                    const key = el.getAttribute('data-lfms-original-placeholder') || el.placeholder;
                    if (!el.hasAttribute('data-lfms-original-placeholder')) el.setAttribute('data-lfms-original-placeholder', key);
                    const translated = looseTranslations[key] || translations[key];
                    if (language === 'bn' && translated) el.placeholder = translated;
                    if (language === 'en') el.placeholder = key;
                });
                translateLooseText(language);
                document.querySelectorAll('[title], [aria-label]').forEach(el => {
                    const titleKey = el.getAttribute('data-lfms-original-title') || el.getAttribute('title');
                    const ariaKey = el.getAttribute('data-lfms-original-aria') || el.getAttribute('aria-label');
                    if (titleKey && !el.hasAttribute('data-lfms-original-title')) el.setAttribute('data-lfms-original-title', titleKey);
                    if (ariaKey && !el.hasAttribute('data-lfms-original-aria')) el.setAttribute('data-lfms-original-aria', ariaKey);
                    if (titleKey && extraTranslations[titleKey] && language === 'bn') el.setAttribute('title', extraTranslations[titleKey]);
                    else if (titleKey && language === 'en') el.setAttribute('title', titleKey);
                    if (ariaKey && extraTranslations[ariaKey] && language === 'bn') el.setAttribute('aria-label', extraTranslations[ariaKey]);
                    else if (ariaKey && language === 'en') el.setAttribute('aria-label', ariaKey);
                });
                const pageTitle = document.title;
                const separator = ' - ';
                const titleBase = pageTitle.includes(separator) ? pageTitle.split(separator)[0] : pageTitle;
                const translatedTitle = extraTranslations[titleBase] || translations[titleBase];
                if (language === 'bn' && translatedTitle) document.title = translatedTitle + separator + 'লস্ট অ্যান্ড ফাউন্ড';
                document.documentElement.lang = language === 'bn' ? 'bn' : 'en';
                const label = document.getElementById('languageLabel');
                if (label) label.textContent = language === 'bn' ? 'English' : 'বাংলা';
            }
            function applyTheme(theme) {
                const root = document.documentElement;
                const isDark = theme === 'dark';
                root.classList.toggle('dark-mode', isDark);
                root.dataset.theme = isDark ? 'dark' : 'light';
                localStorage.setItem('lfms-theme', isDark ? 'dark' : 'light');
                const button = document.getElementById('themeToggle');
                if (button) {
                    button.setAttribute('aria-pressed', isDark ? 'true' : 'false');
                    button.title = isDark ? 'Switch to Light mode' : 'Switch to Dark mode';
                }
            }

            function applyLanguage(language) {
                const normalized = language === 'bn' ? 'bn' : 'en';
                localStorage.setItem('lfms-language', normalized);
                translateText(normalized);
                document.documentElement.lang = normalized;
                document.documentElement.dataset.language = normalized;
            }

            const savedLanguage = localStorage.getItem('lfms-language') || 'en';
            const savedTheme = localStorage.getItem('lfms-theme') || 'light';
            applyTheme(savedTheme);
            applyLanguage(savedLanguage);
            initializeToastMessages();

            const languageButton = document.getElementById('languageToggle');
            if (languageButton) {
                languageButton.addEventListener('click', function () {
                    const current = localStorage.getItem('lfms-language') || 'en';
                    const next = current === 'bn' ? 'en' : 'bn';
                    localStorage.setItem('lfms-language', next);
                    // Reload from the original server text so every page and every text node
                    // gets translated consistently in both directions.
                    window.location.reload();
                });
            }

            function initializeToastMessages() {
                const candidates = document.querySelectorAll('.success-message, .notice-success, .notice-error, .manage-alert.success, .manage-alert.error, .detail-flash');
                if (!candidates.length) return;

                let container = document.querySelector('.lfms-toast-container');
                if (!container) {
                    container = document.createElement('div');
                    container.className = 'lfms-toast-container';
                    container.setAttribute('aria-live', 'polite');
                    container.setAttribute('aria-atomic', 'true');
                    document.body.appendChild(container);
                }

                candidates.forEach(function (source) {
                    if (source.dataset.toastInitialized === 'true') return;
                    source.dataset.toastInitialized = 'true';

                    const toast = document.createElement('div');
                    const isError = source.classList.contains('error') || source.classList.contains('notice-error');
                    toast.className = 'lfms-toast ' + (isError ? 'lfms-toast-error' : 'lfms-toast-success');

                    const message = document.createElement('div');
                    message.className = 'lfms-toast-message';
                    message.textContent = source.textContent.trim();

                    const close = document.createElement('button');
                    close.type = 'button';
                    close.className = 'lfms-toast-close';
                    close.setAttribute('aria-label', 'Close notification');
                    close.title = 'Close';
                    close.textContent = '×';

                    toast.appendChild(message);
                    toast.appendChild(close);
                    container.appendChild(toast);
                    source.remove();

                    requestAnimationFrame(function () { toast.classList.add('is-visible'); });

                    let timer = window.setTimeout(function () { dismissToast(toast); }, 3000);
                    close.addEventListener('click', function () {
                        window.clearTimeout(timer);
                        dismissToast(toast);
                    });
                });
            }

            function dismissToast(toast) {
                if (!toast || toast.dataset.closing === 'true') return;
                toast.dataset.closing = 'true';
                toast.classList.remove('is-visible');
                window.setTimeout(function () { toast.remove(); }, 220);
            }

            const themeButton = document.getElementById('themeToggle');
            if (themeButton) {
                themeButton.addEventListener('click', function () {
                    const current = document.documentElement.classList.contains('dark-mode') ? 'dark' : 'light';
                    applyTheme(current === 'dark' ? 'light' : 'dark');
                });
            }

            // Password eye buttons work on all normal Razor MVC pages.
            document.querySelectorAll('[data-password-toggle]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const wrap = button.closest('.password-input-wrap');
                    const input = wrap ? wrap.querySelector('input') : null;
                    if (!input) return;
                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    button.setAttribute('aria-pressed', show ? 'true' : 'false');
                    button.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    const eye = button.querySelector('[data-eye]');
                    const eyeOff = button.querySelector('[data-eye-off]');
                    if (eye) eye.style.display = show ? 'none' : 'block';
                    if (eyeOff) eyeOff.style.display = show ? 'block' : 'none';
                });
            });
        })();
    </script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
