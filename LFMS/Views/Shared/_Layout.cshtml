<!DOCTYPE html>
<html lang="en" data-lfms-root>
@using LFMS.Data
@inject ApplicationDbContext AppDb
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lost & Found</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lfms-second-reference.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero-icon-banner.css" asp-append-version="true" />
    <script>
        (function () {
            const theme = localStorage.getItem('lfms-theme');
            if (theme === 'dark') document.documentElement.classList.add('dark-mode');
            const language = localStorage.getItem('lfms-language');
            if (language === 'bn') document.documentElement.lang = 'bn';
        })();
    </script>
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid page-width">
            <a class="navbar-brand lfms-logo-brand" asp-controller="Home" asp-action="Index" aria-label="Lost & Found"><img src="~/images/lost-find-logo.png" alt="Lost & Found" /></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav align-items-lg-center gap-lg-1 w-100">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" data-i18n="Home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-type="Lost" data-i18n="Lost">Lost</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-type="Found" data-i18n="Found">Found</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var currentNavUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                        var unreadNavNotifications = currentNavUserId == null ? 0 : AppDb.Notifications.Count(n => n.UserId == currentNavUserId && !n.IsRead);
                        var unreadNavMessages = currentNavUserId == null ? 0 : AppDb.ChatMessages.Count(n => n.ReceiverId == currentNavUserId && !n.IsRead);

                        <li class="nav-item nav-action-item"><a class="nav-link" asp-controller="Posts" asp-action="Create" data-i18n="Create Post">Create Post</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item nav-action-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard" data-i18n="Admin">Admin</a></li>
                        }

                        <li class="nav-spacer"></li>

                        <li class="nav-item nav-preference-item">
                            <button type="button" class="nav-preference-button" id="languageToggle" title="বাংলা / English" aria-label="বাংলা / English"><span id="languageLabel">বাংলা</span></button>
                        </li>
                        <li class="nav-item nav-preference-item">
                            <button type="button" class="nav-preference-button theme-toggle" id="themeToggle" title="Light / Dark mode" aria-label="Light / Dark mode">
                                <span class="theme-icon theme-sun" aria-hidden="true">☼</span><span class="theme-icon theme-moon" aria-hidden="true">◐</span>
                            </button>
                        </li>

                        <li class="nav-utility-group" aria-label="Account actions">
                            <a class="nav-icon-link" asp-controller="Chat" asp-action="Inbox" aria-label="Messages" title="Messages">
                                <span class="nav-svg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5h16v11H8l-4 3v-14Z"/><path d="M8 10h8M8 13h5"/></svg></span>
                                @if (unreadNavMessages > 0) { <span class="notification-badge nav-icon-badge">@(unreadNavMessages > 99 ? "99+" : unreadNavMessages.ToString())</span> }
                            </a>
                            <a class="nav-icon-link" asp-controller="Notifications" asp-action="Index" aria-label="Notifications" title="Notifications">
                                <span class="nav-svg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg></span>
                                @if (unreadNavNotifications > 0) { <span class="notification-badge nav-icon-badge">@(unreadNavNotifications > 99 ? "99+" : unreadNavNotifications.ToString())</span> }
                            </a>
                            <a class="nav-icon-link" asp-controller="Profile" asp-action="Index" aria-label="Profile" title="Profile">
                                <span class="nav-svg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.7-4 3-6 7-6s6.3 2 7 6"/></svg></span>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="nav-icon-link" asp-controller="Admin" asp-action="Settings" aria-label="Settings" title="Settings">
                                    <span class="nav-svg-icon settings-gear-icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" role="img">
                                            <path d="M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Z"/>
                                            <path d="M19.4 13.5a7.7 7.7 0 0 0 0-3l2-1.5-2-3.4-2.4 1a8 8 0 0 0-2.6-1.5L14 2.5h-4l-.4 2.6A8 8 0 0 0 7 6.6l-2.4-1-2 3.4 2 1.5a7.7 7.7 0 0 0 0 3l-2 1.5 2 3.4 2.4-1a8 8 0 0 0 2.6 1.5l.4 2.6h4l.4-2.6a8 8 0 0 0 2.6-1.5l2.4 1 2-3.4-2-1.5Z"/>
                                        </svg>
                                    </span>
                                </a>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="nav-logout-form">
                                <button class="nav-icon-link nav-logout-button" type="submit" aria-label="Logout" title="Logout">
                                    <span class="nav-svg-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></svg></span>
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-spacer"></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login" data-i18n="Login">Login</a></li>
                        <li class="nav-item"><a class="btn btn-accent btn-sm px-3" asp-controller="Account" asp-action="Register" data-i18n="Register">Register</a></li>
                        <li class="nav-item nav-preference-item">
                            <button type="button" class="nav-preference-button" id="languageToggle" title="বাংলা / English" aria-label="বাংলা / English"><span id="languageLabel">বাংলা</span></button>
                        </li>
                        <li class="nav-item nav-preference-item">
                            <button type="button" class="nav-preference-button theme-toggle" id="themeToggle" title="Light / Dark mode" aria-label="Light / Dark mode"><span class="theme-icon theme-sun" aria-hidden="true">☼</span><span class="theme-icon theme-moon" aria-hidden="true">◐</span></button>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<main class="page-width py-4">@RenderBody()</main>
    <footer class="footer page-width" style="text-align: center;">&copy; 2026 Lost &amp; Found Management System</footer>
